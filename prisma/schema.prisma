generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  COUPLE
  VENDOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum SubscriptionTier {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  NEW
  REPLIED
  BOOKED
  CLOSED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PriceTier {
  BUDGET
  MID_RANGE
  LUXURY
  ULTRA_LUXURY
}

enum RsvpStatus {
  PENDING
  ATTENDING
  DECLINED
  MAYBE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(COUPLE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  coupleProfile CoupleProfile?
  vendorProfile VendorProfile?
  reviews       Review[]
  auditLogs     AuditLog[]
}

model CoupleProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  partnerName    String?
  weddingDate    DateTime?
  weddingCity    String?
  weddingCountry String?
  guestCount     Int?
  totalBudget    Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites Favorite[]
  inquiries Inquiry[]
  checklist WeddingChecklist?
  budgets   BudgetCategory[]
  guests    Guest[]
  reviews   Review[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  vendors VendorProfile[]
}

model VendorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  categoryId         String
  businessName       String
  slug               String             @unique
  tagline            String?
  description        String?            @db.Text
  website            String?
  phone              String?
  email              String?
  address            String?
  city               String?
  state              String?
  country            String             @default("AU")
  latitude           Float?
  longitude          Float?
  priceTier          PriceTier          @default(MID_RANGE)
  priceFrom          Float?
  priceTo            Float?
  avgRating          Float              @default(0)
  reviewCount        Int                @default(0)
  profileViews       Int                @default(0)
  inquiryCount       Int                @default(0)
  isFeatured         Boolean            @default(false)
  featuredUntil      DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  completenessScore  Int                @default(0)
  stripeCustomerId   String?
  yearsInBusiness    Int?
  teamSize           Int?
  instagramUrl       String?
  facebookUrl        String?
  youtubeUrl         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id])
  serviceAreas  ServiceArea[]
  media         MediaAsset[]
  reviews       Review[]
  inquiries     Inquiry[]
  subscription  Subscription?
  realWeddings  RealWedding[]
  availability  VendorAvailability[]
}

model ServiceArea {
  id        String   @id @default(cuid())
  vendorId  String
  city      String
  state     String?
  country   String   @default("AU")
  createdAt DateTime @default(now())

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, city, country])
}

model MediaAsset {
  id          String    @id @default(cuid())
  vendorId    String
  type        MediaType @default(IMAGE)
  url         String
  thumbnailUrl String?
  caption     String?
  altText     String?
  sortOrder   Int       @default(0)
  isCover     Boolean   @default(false)
  s3Key       String?
  createdAt   DateTime  @default(now())

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Review {
  id             String       @id @default(cuid())
  vendorId       String
  coupleProfileId String
  userId         String
  rating         Float
  title          String
  body           String       @db.Text
  weddingDate    DateTime?
  status         ReviewStatus @default(PENDING)
  vendorReply    String?      @db.Text
  repliedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  vendor  VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  couple  CoupleProfile @relation(fields: [coupleProfileId], references: [id])
  user    User          @relation(fields: [userId], references: [id])
}

model Inquiry {
  id              String        @id @default(cuid())
  vendorId        String
  coupleProfileId String
  status          InquiryStatus @default(NEW)
  eventDate       DateTime?
  guestCount      Int?
  budget          Float?
  message         String        @db.Text
  firstRepliedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vendor        VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  couple        CoupleProfile @relation(fields: [coupleProfileId], references: [id])
  conversations Conversation[]
}

model Conversation {
  id            String    @id @default(cuid())
  inquiryId     String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  inquiry  Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.Text
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Favorite {
  id              String   @id @default(cuid())
  coupleProfileId String
  vendorId        String
  createdAt       DateTime @default(now())

  couple CoupleProfile @relation(fields: [coupleProfileId], references: [id], onDelete: Cascade)

  @@unique([coupleProfileId, vendorId])
}

model VendorAvailability {
  id        String   @id @default(cuid())
  vendorId  String
  date      DateTime @db.Date
  isBooked  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
}

model Subscription {
  id                   String             @id @default(cuid())
  vendorId             String             @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model RealWedding {
  id          String   @id @default(cuid())
  vendorId    String
  title       String
  slug        String   @unique
  description String?  @db.Text
  weddingDate DateTime?
  venue       String?
  city        String?
  coverImage  String?
  images      String[]
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model WeddingChecklist {
  id              String   @id @default(cuid())
  coupleProfileId String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  couple CoupleProfile   @relation(fields: [coupleProfileId], references: [id], onDelete: Cascade)
  tasks  ChecklistTask[]
}

model ChecklistTask {
  id          String   @id @default(cuid())
  checklistId String
  title       String
  description String?
  dueDate     DateTime?
  isCompleted Boolean  @default(false)
  isDefault   Boolean  @default(true)
  category    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklist WeddingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model BudgetCategory {
  id              String   @id @default(cuid())
  coupleProfileId String
  name            String
  allocatedAmount Float    @default(0)
  color           String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  couple CoupleProfile @relation(fields: [coupleProfileId], references: [id], onDelete: Cascade)
  items  BudgetItem[]
}

model BudgetItem {
  id               String   @id @default(cuid())
  budgetCategoryId String
  vendorName       String?
  description      String
  estimatedCost    Float    @default(0)
  actualCost       Float?
  isPaid           Boolean  @default(false)
  dueDate          DateTime?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category BudgetCategory @relation(fields: [budgetCategoryId], references: [id], onDelete: Cascade)
}

model Guest {
  id              String     @id @default(cuid())
  coupleProfileId String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  rsvpStatus      RsvpStatus @default(PENDING)
  dietaryNeeds    String?
  plusOne         Boolean    @default(false)
  tableNumber     Int?
  side            String?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  couple CoupleProfile @relation(fields: [coupleProfileId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])
}
